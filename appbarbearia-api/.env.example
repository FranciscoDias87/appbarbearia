NODE_ENV=development
PORT=3001
# No painel Supabase: Connect > Session pooler (porta 5432).
# Crie o usuário `prisma` no Database > Roles e substitua os valores abaixo.
DATABASE_URL="postgresql://prisma.[PROJECT-REF]:[SENHA-PRISMA]@[REGIAO].pooler.supabase.com:5432/postgres?sslmode=require"
# Usada pelo Prisma CLI para migrations. Em redes IPv4, use a mesma Session pooler.
DIRECT_URL="postgresql://prisma.[PROJECT-REF]:[SENHA-PRISMA]@[REGIAO].pooler.supabase.com:5432/postgres?sslmode=require"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"
FRONTEND_URL="http://localhost:3000"
